#include "recycle.usr"
#define INTP_NMAX 50000 /* number of sample points */
c-----------------------------------------------------------------------
      subroutine avg_custom
      include 'SIZE'
      include 'TOTAL'

c Arrays following the NekRS reference frame

c First order
      real*8 u_nek(lx1,ly1,lz1,lelt),v_nek(lx1,ly1,lz1,lelt),
     & w_nek(lx1,ly1,lz1,lelt)

c Second order
      real*8 uu_nek(lx1,ly1,lz1,lelt),vv_nek(lx1,ly1,lz1,lelt),
     & ww_nek(lx1,ly1,lz1,lelt), uv_nek(lx1,ly1,lz1,lelt),
     & uw_nek(lx1,ly1,lz1,lelt), vw_nek(lx1,ly1,lz1,lelt)

c Arrays following the experiment reference frame

c First order
      real*8 u_exp(lx1,ly1,lz1,lelt),v_exp(lx1,ly1,lz1,lelt),
     & w_exp(lx1,ly1,lz1,lelt)

c Second order
      real*8 uu_exp(lx1,ly1,lz1,lelt),vv_exp(lx1,ly1,lz1,lelt),
     & ww_exp(lx1,ly1,lz1,lelt), uv_exp(lx1,ly1,lz1,lelt),
     & uw_exp(lx1,ly1,lz1,lelt), vw_exp(lx1,ly1,lz1,lelt)

c Angle for frame transformation
      real alpha,cosa,sina,cosa2,sina2,cosina

      integer e, ndir, nfil, ftot, ndir_shit, ndir_init, ndir_final

c Initizalizing arrays and alpha

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         u_nek(i,j,k,e)  = 0.0
         v_nek(i,j,k,e)  = 0.0
         w_nek(i,j,k,e)  = 0.0
         uu_nek(i,j,k,e) = 0.0
         vv_nek(i,j,k,e) = 0.0
         ww_nek(i,j,k,e) = 0.0
         uv_nek(i,j,k,e) = 0.0
         uw_nek(i,j,k,e) = 0.0
         vw_nek(i,j,k,e) = 0.0
         u_exp(i,j,k,e)  = 0.0
         v_exp(i,j,k,e)  = 0.0
         w_exp(i,j,k,e)  = 0.0
         uu_exp(i,j,k,e) = 0.0
         vv_exp(i,j,k,e) = 0.0
         ww_exp(i,j,k,e) = 0.0
         uv_exp(i,j,k,e) = 0.0
         uw_exp(i,j,k,e) = 0.0
         vw_exp(i,j,k,e) = 0.0
      enddo
      enddo
      enddo
      enddo

      ndir = 35
      nfil = 1
      ftot = ndir*nfil
      ndir_shift = 0
      ndir_init = ndir_shift + 1
      ndir_final= ndir_init + ndir - 1

      do iiq=ndir_init,ndir_final
      do iip=1,nfil

      call blank(initc(1),70)
      write(initc(1),7)iiq,iip

   7       format('./runs/run_dir'
     &     ,i2.2,'/avgmichigan0.f',i5.5)
      call setics

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         u_nek(i,j,k,e)=u_nek(i,j,k,e)+vx(i,j,k,e)/(ftot)
         v_nek(i,j,k,e)=v_nek(i,j,k,e)+vy(i,j,k,e)/(ftot)
         w_nek(i,j,k,e)=w_nek(i,j,k,e)+vz(i,j,k,e)/(ftot)
      enddo
      enddo
      enddo
      enddo

      enddo
      enddo

c Adjusting the frame to the experiment

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         u_exp(i,j,k,e)=u_nek(i,j,k,e)
         v_exp(i,j,k,e)=v_nek(i,j,k,e)
         w_exp(i,j,k,e)=w_nek(i,j,k,e)
      enddo
      enddo
      enddo
      enddo

      call outpost2(u_exp,v_exp,w_exp,pr,t,ldimt,'avg')

      do iiq=ndir_init,ndir_final
      do iip=1,nfil

      call blank(initc(1),70)
      write(initc(1),8)iiq,iip

   8       format('./runs/run_dir'
     &     ,i2.2,'/rmsmichigan0.f',i5.5)
      call setics

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         uu_nek(i,j,k,e)=uu_nek(i,j,k,e)+vx(i,j,k,e)/(ftot)
         vv_nek(i,j,k,e)=vv_nek(i,j,k,e)+vy(i,j,k,e)/(ftot)
         ww_nek(i,j,k,e)=ww_nek(i,j,k,e)+vz(i,j,k,e)/(ftot)
      enddo
      enddo
      enddo
      enddo

      enddo
      enddo

      do iiq=ndir_init,ndir_final
      do iip=1,nfil

      call blank(initc(1),70)
      write(initc(1),9)iiq,iip

   9       format('./runs/run_dir'
     &     ,i2.2,'/rm2michigan0.f',i5.5)
      call setics

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         uv_nek(i,j,k,e)=uv_nek(i,j,k,e)+vx(i,j,k,e)/(ftot)
         uw_nek(i,j,k,e)=uw_nek(i,j,k,e)+vy(i,j,k,e)/(ftot)
         vw_nek(i,j,k,e)=vw_nek(i,j,k,e)+vz(i,j,k,e)/(ftot)
      enddo
      enddo
      enddo
      enddo

      enddo
      enddo

c Adjusting the frame to the experiment

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         uu_exp(i,j,k,e)=uu_nek(i,j,k,e)
     &                  -u_nek(i,j,k,e)*u_nek(i,j,k,e)
         vv_exp(i,j,k,e)=vv_nek(i,j,k,e)
     &                  -v_nek(i,j,k,e)*v_nek(i,j,k,e)
         ww_exp(i,j,k,e)=ww_nek(i,j,k,e)
     &                  -w_nek(i,j,k,e)*w_nek(i,j,k,e)
      enddo
      enddo
      enddo
      enddo

      call outpost2(uu_exp,vv_exp,ww_exp,pr,t,ldimt,'rms')

c Adjusting the frame to the experiment

      do i=1,lx1
      do j=1,ly1
      do k=1,lz1
      do e=1,lelt
         uv_exp(i,j,k,e)=uv_nek(i,j,k,e)
     &                  -u_nek(i,j,k,e)*v_nek(i,j,k,e)
         uw_exp(i,j,k,e)=uw_nek(i,j,k,e)
     &                  -u_nek(i,j,k,e)*w_nek(i,j,k,e)
         vw_exp(i,j,k,e)=vw_nek(i,j,k,e)
     &                  -v_nek(i,j,k,e)*w_nek(i,j,k,e)
      enddo
      enddo
      enddo
      enddo

      call outpost2(uv_exp,uw_exp,vw_exp,pr,t,ldimt,'rm2')

      return
      end
