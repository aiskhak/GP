c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

c Initialize with low value everywhere

      ux   = 0.0
      uy   = 0.0001
      uz   = 0.0
      temp = 0.0

c Triggering turbulence at the recycling region from the inlet

      YLENGTH = 30.0
      R_dome_inlet = 85.0*0.5
      R_dome_inlet = R_dome_inlet/17.5

      x_inlet=R_dome_inlet*cos(pi/2)
      z_inlet=R_dome_inlet*sin(pi/2)

      xr = (x-x_inlet)*2.0
      zr = (z-z_inlet)*2.0
      rr = xr*xr + zr*zr
      if (rr.gt.0) rr=sqrt(rr)
      th = atan2(zr,xr)
      yo = 3.0*2.0*pi*y/YLENGTH

      if (y.lt.2.0) then
        if (rr.lt.1.0) then
          uy = 6.*(1-rr**6)/5.
        endif
      endif

c     Assign a wiggly shear layer near the wall
      amp_y    = 0.35  ! Fraction of 2pi for y-based phase modification
      freq_y   = 4     ! Number of wiggles in axial- (y-) direction
      freq_t   = 9     ! Frequency of wiggles in azimuthal-direction

      amp_tht  = 5     ! Amplification factor for clipped sine function
      amp_clip = 0.2   ! Clipped amplitude

      blt      = 0.07  ! Fraction of boundary layer with momentum deficit

      phase_y = amp_y*(2*pi)*sin(freq_y*yo)

      arg_tht = freq_t*th + phase_y
      amp_sin = 5*sin(arg_tht)
      if (amp_sin.gt. amp_clip) amp_sin =  amp_clip
      if (amp_sin.lt.-amp_clip) amp_sin = -amp_clip

      if (y.lt.2.0) then
        if (rr.lt.1.0) then
          if (rr.gt.(1-blt)) uy = uy + amp_sin
        endif
      endif

c     Quick P-independent randomizer
      big  = 1.e3*eg + 1.e2*ix + 1.e1*iy + 1.e0*iz
      rand = sin(big)

      if (y.lt.0.0) then
        if (rr.lt.1.0) then
          ux   = .05*rand*rand
          uy   = uy + .1*rand
          uz   = .10*rand*rand*rand
          temp = 1.
        endif
      endif

c Initialize with low value everywhere

c      ux   = 0.0
c      uy   = 0.0001
c      uz   = 0.0
c      temp = 0.0

c Initialize with 1 just at the recycling region

c      if (y.lt.-5.0) then
c        if (abs(z).lt.2.0) then
c          if(abs(x).lt.2.0) then
c            uy   = 1.0
c          endif
c        endif
c      endif

      return
      end
